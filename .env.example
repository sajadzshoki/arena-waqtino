# ── Waqtino environment ─────────────────────────────────────────────
# Data source of the frontend:  mock | api
#   mock → in-browser mock repositories (no backend needed, Phase 0 default)
#   api  → real AdonisJS backend (activated in a later phase)
NUXT_PUBLIC_API_MODE=mock

# Base URL of the AdonisJS backend (used only when API_MODE=api)
NUXT_PUBLIC_API_BASE_URL=

# Development only: deterministic OTP code accepted by the mock auth service.
# Never used when API_MODE=api.
NUXT_PUBLIC_MOCK_OTP_CODE=1234
